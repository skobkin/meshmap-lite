# syntax=docker/dockerfile:1

# Release CI uses this Dockerfile after frontend assets were already built by
# the dedicated `frontend-build` Woodpecker step and placed into
# `internal/frontend/assets/dist` for embedding into the binary.
FROM golang:1.25-alpine AS go-build
WORKDIR /src
ARG VERSION=dev
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w -X meshmap-lite/internal/buildinfo.Version=${VERSION}" -o /out/server ./cmd/server

FROM alpine:3.23
LABEL org.opencontainers.image.source="https://github.com/skobkin/meshmap-lite"
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=go-build /out/server /usr/local/bin/server
EXPOSE 8080
USER app
ENTRYPOINT ["server"]
